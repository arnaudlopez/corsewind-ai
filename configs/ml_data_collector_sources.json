{
  "format": "corsewind.ml_data_collector_sources.v1",
  "policy": {
    "official_collector_host": "z2",
    "official_dataset_root": "/srv/data/corsewind/ml_dataset",
    "source_of_truth": "autonomous_raw_first_collector",
    "wind2d_role": "consumer_or_legacy_or_explicit_bridge_only",
    "allow_permanent_partial_collector": false,
    "raw_cleanup_rule": "cleanup_only_temporary_caches_after_raw_or_subset_archive_is_written"
  },
  "defaults": {
    "bbox_wgs84": [8.45, 41.25, 9.75, 43.1],
    "registry": "configs/ml_spots.json",
    "include_context_spots": true,
    "minimum_free_gb": 40
  },
  "sources": [
    {
      "key": "beacon_live_observations",
      "priority": "P0",
      "required_for_official": true,
      "official_ready": true,
      "kind": "live_observations",
      "provider": "Beacon Live weather-state",
      "cadence_seconds": 300,
      "target_roots": ["observations/beacon_live"],
      "required_env": [],
      "notes": "Local/live observation source used as target and context for non-Meteo-France relays. Beacon sources with source_type=meteofrance are skipped by default because direct DPObs is the official Meteo-France source."
    },
    {
      "key": "meteo_france_live_observations",
      "priority": "P0",
      "required_for_official": true,
      "official_ready": true,
      "kind": "live_observations",
      "provider": "Meteo-France DPObs",
      "cadence_seconds": 360,
      "target_roots": ["observations/meteo_france"],
      "required_env": ["METEOFRANCE_API_KEY"],
      "modes": ["station-6m", "station-hourly", "synop", "bouees"],
      "notes": "Recent station/SYNOP/buoy observations for target and context."
    },
    {
      "key": "remote_wind2d_model_layers",
      "priority": "P0",
      "required_for_official": false,
      "official_ready": true,
      "kind": "remote_model_layers",
      "provider": "CorseWind forecast-engine Wind2D layers",
      "cadence_seconds": 300,
      "target_roots": ["model_runs", "model_samples"],
      "required_env": ["ML_REMOTE_MODEL_CONTAINER_SSH"],
      "sources": ["arome", "aromepi"],
      "sample_method": "bilinear",
      "include_context_spots": true,
      "skip_existing_runs": true,
      "collector_skip_last_run": false,
      "notes": "Archives the operational Wind2D AROME/AROME-PI layers produced by forecast-engine and samples them at ML spots. This is the production-baseline bridge for residual training."
    },
    {
      "key": "meteo_france_arome_surface_fields",
      "priority": "P0",
      "required_for_official": true,
      "official_ready": true,
      "kind": "native_nwp_surface_fields",
      "provider": "Meteo-France AROME WCS",
      "cadence_seconds": 900,
      "target_roots": ["meteo_france_nwp/raw/extra_fields", "meteo_france_nwp/extra_field_samples"],
      "required_env": ["METEOFRANCE_API_KEY"],
      "source": "arome",
      "resolution": "001",
      "max_steps": 12,
      "features": [
        "temperature_2m_c",
        "dewpoint_2m_c",
        "relative_humidity_2m_pct",
        "pressure_msl_hpa",
        "pressure_surface_hpa",
        "low_cloud_cover_pct",
        "total_cloud_cover_pct",
        "pbl_height_m",
        "cape_j_kg",
        "downward_shortwave_flux_w_m2"
      ],
      "notes": "Raw-first surface/context fields, independent from Wind2D."
    },
    {
      "key": "meteo_france_aromepi_surface_fields",
      "priority": "P0",
      "required_for_official": true,
      "official_ready": true,
      "kind": "native_nwp_surface_fields",
      "provider": "Meteo-France AROME-PI WCS",
      "cadence_seconds": 300,
      "target_roots": ["meteo_france_nwp/raw/extra_fields", "meteo_france_nwp/extra_field_samples"],
      "required_env": ["METEOFRANCE_API_KEY"],
      "source": "aromepi",
      "resolution": "0025",
      "max_steps": 24,
      "features": [
        "temperature_2m_c",
        "dewpoint_10m_c",
        "relative_humidity_10m_pct",
        "pressure_msl_hpa",
        "cloud_cover_pct",
        "downward_shortwave_flux_w_m2",
        "direct_downward_shortwave_flux_w_m2",
        "net_shortwave_clear_sky_w_m2"
      ],
      "notes": "AROME-PI short-horizon thermal/context fields sampled at spots."
    },
    {
      "key": "meteo_france_arome_vertical_profiles",
      "priority": "P0",
      "required_for_official": true,
      "official_ready": true,
      "kind": "native_nwp_vertical_profiles",
      "provider": "Meteo-France AROME WCS",
      "cadence_seconds": 900,
      "target_roots": ["meteo_france_nwp/raw/vertical_profiles", "meteo_france_nwp/vertical_profiles"],
      "required_env": ["METEOFRANCE_API_KEY"],
      "source": "arome",
      "resolution": "0025",
      "max_steps": 5,
      "pressure_levels_hpa": [1000, 950, 925, 900, 850],
      "notes": "Vertical column features for thermal setup and low-level stability."
    },
    {
      "key": "copernicus_marine_sst",
      "priority": "P0",
      "required_for_official": true,
      "official_ready": true,
      "kind": "ocean_satellite",
      "provider": "Copernicus Marine",
      "cadence_seconds": 3600,
      "target_roots": ["copernicus_marine/raw/sst", "copernicus_marine/sst_samples"],
      "required_env": ["COPERNICUSMARINE_SERVICE_USERNAME", "COPERNICUSMARINE_SERVICE_PASSWORD"],
      "window_hours": 6,
      "end_lag_hours": 48,
      "notes": "SST used for sea-land thermal contrast. Raw NetCDF retained by default. NRT availability can lag more than 24h, so the live collector uses a conservative 48h delay."
    },
    {
      "key": "eumetsat_cloud_mask",
      "priority": "P1",
      "required_for_official": true,
      "official_ready": true,
      "kind": "satellite_cloud",
      "provider": "EUMETSAT Data Store",
      "cadence_seconds": 480,
      "target_roots": ["eumetsat/raw/cloud_mask", "eumetsat/cloud_mask_samples"],
      "required_env": ["EUMETSAT_CONSUMER_KEY", "EUMETSAT_CONSUMER_SECRET"],
      "window_minutes": 120,
      "end_lag_minutes": 5,
      "max_products": 18,
      "notes": "Cloud mask context. Raw NetCDF retained by default."
    },
    {
      "key": "eumetsat_cloud_type",
      "priority": "P0",
      "required_for_official": true,
      "official_ready": true,
      "kind": "satellite_cloud_type",
      "provider": "EUMETSAT Data Store",
      "cadence_seconds": 900,
      "target_roots": ["eumetsat/raw/cloud_type", "eumetsat/cloud_type_samples"],
      "required_env": ["EUMETSAT_CONSUMER_KEY", "EUMETSAT_CONSUMER_SECRET"],
      "product": "cloud_type",
      "window_minutes": 180,
      "end_lag_minutes": 10,
      "max_products": 12,
      "notes": "Distinguishes clear sky, low marine cloud, high cloud and convection."
    },
    {
      "key": "eumetsat_land_surface_temperature",
      "priority": "P0",
      "required_for_official": true,
      "official_ready": true,
      "kind": "satellite_land_temperature",
      "provider": "EUMETSAT Data Store",
      "cadence_seconds": 900,
      "target_roots": ["eumetsat/raw/land_surface_temperature", "eumetsat/land_surface_temperature_samples"],
      "required_env": ["EUMETSAT_CONSUMER_KEY", "EUMETSAT_CONSUMER_SECRET"],
      "product": "land_surface_temperature",
      "window_minutes": 180,
      "end_lag_minutes": 10,
      "max_products": 12,
      "notes": "Observed land heating feature for land-sea thermal contrast."
    },
    {
      "key": "eumetsat_global_instability_indices",
      "priority": "P0",
      "required_for_official": true,
      "official_ready": true,
      "kind": "satellite_instability",
      "provider": "EUMETSAT Data Store",
      "cadence_seconds": 900,
      "target_roots": ["eumetsat/raw/global_instability_indices", "eumetsat/global_instability_indices_samples"],
      "required_env": ["EUMETSAT_CONSUMER_KEY", "EUMETSAT_CONSUMER_SECRET"],
      "product": "global_instability_indices",
      "window_minutes": 180,
      "end_lag_minutes": 10,
      "max_products": 12,
      "notes": "Observed instability and water-vapour context."
    },
    {
      "key": "meteo_france_radar_precipitation",
      "priority": "P2",
      "required_for_official": false,
      "official_ready": false,
      "kind": "radar_precipitation",
      "provider": "Meteo-France DPPaquetRadar",
      "target_roots": ["radar/raw", "radar/spot_samples"],
      "required_env": ["METEOFRANCE_API_KEY"],
      "blocking_reason": "Raw radar spot sampler not implemented yet.",
      "notes": "Useful for perturbed/convection regimes, not mandatory for first official thermal collector."
    },
    {
      "key": "moloch_native_raw",
      "priority": "P1",
      "required_for_official": false,
      "official_ready": false,
      "kind": "native_nwp_grib",
      "provider": "MeteoHub / CNR-ISAC MOLOCH",
      "target_roots": ["moloch/raw", "moloch/model_samples"],
      "required_env": [],
      "blocking_reason": "Native full-variable field matrix not selected yet.",
      "notes": "Wind-only bridge exists; official raw-first variable list still needs selection."
    },
    {
      "key": "icon2i_native_raw",
      "priority": "P1",
      "required_for_official": false,
      "official_ready": false,
      "kind": "native_nwp_grib",
      "provider": "MeteoHub / ItaliaMeteo ICON-2I",
      "target_roots": ["icon2i/raw", "icon2i/model_samples"],
      "required_env": [],
      "blocking_reason": "Native full-variable field matrix not selected yet.",
      "notes": "Wind-only bridge exists; official raw-first variable list still needs selection."
    }
  ]
}
